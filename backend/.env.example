# Backend API
PORT=8000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:5173

# MongoDB Atlas (VeloSupplyCluster / velosupply database)
MONGODB_URI=mongodb+srv://velosupply_app:<URL_ENCODED_PASSWORD>@velosupplycluster.pxxsryp.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=velosupply
# Legacy source collection read once during automatic/manual migration; new writes use named collections.
MONGODB_STATE_COLLECTION=application_state
# Only set true for an explicit non-production demo dataset in Atlas; default false.
SEED_DEMO_DATA=false
# Synthetic scenario controls are blocked in production unless explicitly enabled.
SIMULATIONS_ENABLED=false

# Required when creating a new Administrator account
ADMIN_REGISTRATION_KEY=replace-with-a-private-admin-invitation-key

# Required when creating a new Operations team account
OPERATOR_REGISTRATION_KEY=replace-with-a-private-operator-invitation-key

# Weekly Atlas JSON export (Atlas automated backups remain the primary backup system)
BACKUP_EXPORT=false

# External integrations remain inactive until real provider credentials are supplied.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=
EXCHANGE_RATE_SOURCE_URL=
FX_API_KEY=
PAYMENT_PROVIDER_MERCHANT_ID=
PAYMENT_PROVIDER_API_KEY=
PAYMENT_WEBHOOK_SECRET=
COURIER_API_KEY=
COURIER_API_ENV=uat
# JWT_ACCESS_SECRET / JWT_REFRESH_SECRET are the target split-secret names;
# the current API still consumes JWT_SECRET for its existing 12-hour access token.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
